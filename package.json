{
  "name": "@shopsavvy/mcp-server",
  "version": "2.0.0",
  "mcpName": "io.github.shopsavvy/shopsavvy-mcp-server",
  "description": "ShopSavvy MCP server for stdio MCP clients: product lookup, real-time prices across retailers, price history and buying guides. Works without an API key.",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "shopsavvy",
    "product-data",
    "pricing",
    "e-commerce",
    "shopping",
    "ai-tools"
  ],
  "author": "ShopSavvy by Monolith Technologies, Inc.",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shopsavvy/shopsavvy-mcp-server"
  },
  "homepage": "https://shopsavvy.com/agents",
  "bugs": {
    "url": "https://github.com/shopsavvy/shopsavvy-mcp-server/issues"
  },
  "types": "dist/index.d.ts",
  "bin": {
    "shopsavvy-mcp-server": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  }
}
